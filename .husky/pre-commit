#!/usr/bin/env sh
set -e
bash scripts/check-quality.sh

UI_FILES="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(tsx|jsx|css|html)$' || true)"
if [ -n "$UI_FILES" ]; then
  echo "─── Impeccable anti-slop detector ───"
  # shellcheck disable=SC2086
  .agents/skills/impeccable/scripts/impeccable detect $UI_FILES
fi

pnpm lint
pnpm typecheck
